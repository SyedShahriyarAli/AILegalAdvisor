{$SITE_ADDRESS} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }

    handle /api* {
        reverse_proxy backend:5000
    }

    handle /pdfs/* {
        reverse_proxy backend:5000
    }

    handle /health* {
        reverse_proxy backend:5000
    }

    handle {
        reverse_proxy frontend:80
    }
}
