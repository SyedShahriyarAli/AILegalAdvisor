NEO4J_URI=bolt://localhost:7687
# Docker (backend in container, Neo4j on host): bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=abcd1234$

OLLAMA_URL=https://your-subdomain.ngrok-free.app
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_REQUEST_TIMEOUT=300

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=LegalAdvisor
# Docker (Mongo on host): mongodb://host.docker.internal:27017
MONGO_DB_NAME=ai_legal_advisor

# --- Docker / shared nginx (other apps use the same nginx on 80/443) ---
# Caddy in containers: HTTP on host :8080 (all interfaces); nginx terminates TLS and proxies to 127.0.0.1:8080.
# Caddy config is baked into the image (deploy/Dockerfile.caddy); no CADDY_DOCKER_CADDYFILE mount.
#   CADDY_PUBLISH_PORT=8080
# Comment out Caddy's host :443 line in deploy/docker-compose.yml. Add deploy/nginx-ailegaladvisor.conf.example to nginx (see comments in that file).
#
# Optional: if this VM had no nginx and Caddy owned 80/443 directly, edit deploy/Dockerfile.caddy to COPY Caddyfile, set CADDY_PUBLISH_PORT=80, uncomment 443 in compose, rebuild.
# HTTPS site for Caddy / compose (no trailing slash).
SITE_ADDRESS=https://ailegaladvisor.eraconnect.net
# Production SPA: browser calls this origin for /api (same host as the public site if Caddy proxies /api).
VITE_API_BASE_URL=https://ailegaladvisor.eraconnect.net

FLASK_ENV=development
FLASK_DEBUG=True

GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

# Retrieval tunables (multi_stage_retrieval only). Set to 0 to revert to baseline.
RETRIEVAL_CITATION_ANCHOR=1
RETRIEVAL_TUNED_WEIGHTS=1
# Fixed seed so repeated benchmark runs sample the same 30 questions.
RETRIEVAL_BENCHMARK_SEED=42