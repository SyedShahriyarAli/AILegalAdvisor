# Production SPA builds only — backend origin baked into `npm run build` output:
# VITE_API_BASE_URL=https://your-api.example.com

# `npm run dev`: ignore VITE_API_BASE_URL above — calls stay same-origin `/api` (Vite proxy).
# Override Flask proxy target only when backend is not on 127.0.0.1:5000:
# VITE_DEV_BACKEND_PROXY=http://127.0.0.1:5000
